#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'EOF'
Usage: ./cfg <source> [OPTIONS]

  <source>   .fr file to visualize. Can be just the filename
             (searched under programs/source/) or a relative/absolute path.

Options:
  --O1           Compile with O1 optimizations
  --O2           Compile with O2 optimizations
  --compare      Generate O0 vs O2 comparison as side-by-side HTML
                 (use with --O1 to compare O0 vs O1)
  --fmt FORMAT   Image format: svg (default), png, pdf
  --out DIR      Output directory (default: build/cfg/)
  --view         Open image automatically when done
  -h, --help     Show this message and exit

Examples:
  ./cfg opt01_unroll_sum.fr
  ./cfg opt01_unroll_sum.fr --O1
  ./cfg opt01_unroll_sum.fr --O2
  ./cfg opt01_unroll_sum.fr --compare
  ./cfg opt01_unroll_sum.fr --compare --O1
  ./cfg opt01_unroll_sum.fr --fmt png
  ./cfg opt01_unroll_sum.fr --out docs/cfg
  ./cfg opt01_unroll_sum.fr --view
EOF
}

if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
fi

# ==== Resolve source file ====
source="$1"
shift

if [[ "$source" != --* && ! -f "$source" ]]; then
    found=$(find "$SCRIPT_DIR/programs/source" -name "$source" 2>/dev/null | head -1)
    if [[ -n "$found" ]]; then
        source="$found"
    fi
fi

"$SCRIPT_DIR/.venv/bin/python" "$SCRIPT_DIR/tools/visualize_cfg.py" "$source" "$@"
