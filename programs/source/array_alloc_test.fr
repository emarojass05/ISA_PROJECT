fonc [void] num_1_n([int] n, [int] *lista) {
    pour ([int] i = 0; i < n; i++) {
        lista@(i) = i + 1;
    }
    ret;
}

$ Test array sizes from variable
fonc [void] main() {
    [int] a = 10;
    [int] b = 100;
    [int] *lista1(a);
    [int] *lista2(b);
    num_1_n(a, lista1);
    num_1_n(b, lista2);
    ret;
}