$ Test for SymbolTable, LabelTable and FixupTable

? vaulted

[int] global_seed = 7;
[bool] global_flag = vrai;
[int] *global_key = {0x10, 0x20, 0x30, 0x40};

fonc [int] add([int] a, [int] b) {
    [int] result = a + b;
    ret result;
}

fonc [int] mix([int] *data, [int] size, [int] seed) {
    [int] acc = seed;
    [int] i = 0;

    alors (i < size) {
        si (data@(i) > acc) {
            acc = add(acc, data@(i));
        } sinon {
            acc = acc - data@(i);
        }

        i++;
    }

    ret acc;
}

fonc [int] main() {
    [int] *values = {1, 3, 5, 7};

    [int] total = mix(values, 4, global_seed);
    [int] j = 0;

    pour ([int] i = 0; i < 4; i++) {
        si (i == 2) {
            suivre;
        }

        values@(i) = values@(i) + total;
    }

    alors (j < 4) {
        total = total + values@(j);
        j = j + 1;
    }

    si (total >= 20 && global_flag) {
        total = total << 1;
    } sinon {
        total = total >> 1;
    }

    ret total;
}