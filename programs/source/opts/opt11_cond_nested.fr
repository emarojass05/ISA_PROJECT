$ opt11_cond_nested.fr
$ Condicionales anidados con 3 parametros y multiples temporales.
$ a=3, b=4, c=5, s=12, p=12
$ s>10? Si. p>10? Si. res = s+p = 24
$ Resultado esperado: 24
fonc [int] evaluar([int] a, [int] b, [int] c) {
    [int] s = a + b + c;
    [int] p = a * b;
    [int] res = 0;
    si (s > 10) {
        si (p > 10) {
            res = s + p;
        } sinon {
            res = s - p;
        }
    } sinon {
        res = p * c;
    }
    ret res;
}

fonc [int] main() {
    ret evaluar(3, 4, 5);
}
