$ opt10_cond_simple.fr
$ Condicional: scheduler reordena instrucciones independientes en cada rama.
$ suma=3+5=8, prod=3*5=15. suma>prod? No → result=prod-suma=7
$ Resultado esperado: 7
fonc [int] diferencia([int] x, [int] y) {
    [int] suma = x + y;
    [int] prod = x * y;
    [int] result = 0;
    si (suma > prod) {
        result = suma - prod;
    } sinon {
        result = prod - suma;
    }
    ret result;
}

fonc [int] main() {
    ret diferencia(3, 5);
}
