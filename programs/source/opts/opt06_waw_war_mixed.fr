$ opt06_waw_war_mixed.fr
$ Mezcla WAW+WAR: p y q se leen para r, luego p y q se reescriben (WAR),
$ luego r se reescribe usando los nuevos valores (WAW en r).
$ p=3, q=5, r=p*q=15, p=r+2=17, q=p-r=2, r=p*q=34
$ Resultado esperado: 34
fonc [int] mixed_demo() {
    [int] p = 3;
    [int] q = 5;
    [int] r = p * q;
    p = r + 2;
    q = p - r;
    r = p * q;
    ret r;
}

fonc [int] main() {
    ret mixed_demo();
}
