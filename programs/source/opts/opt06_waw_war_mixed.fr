$ opt06_waw_war_mixed.fr
$ Renaming -- mezcla WAW y WAR en m y n.
$ m=5, n=3: prod=15, diff=2, sumsq=34 -> m=17, n=19 -> t=36 -> m=72, n=35
$ Resultado esperado: 122 (72 + 35 + 15)

fonc [int] mixed_deps([int] mi, [int] ni) {
    [int] m    = mi;
    [int] n    = ni;
    [int] prod  = m * n;
    [int] diff  = m - n;
    [int] sumsq = m * m + n * n;
    m = prod + diff;
    n = sumsq - prod;
    [int] t = m + n;
    m = t * 2;
    n = t - 1;
    ret m + n + prod;
}

fonc [int] main() {
    ret mixed_deps(5, 3);
}
