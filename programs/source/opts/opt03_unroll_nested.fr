$ opt03_unroll_nested.fr
$ Loop externo variable (n=4), loop interno trip-count 3.
$ fila = sum(j * (j+1)) for j=0..2 = 0+2+6 = 8
$ total = n * fila = 4 * 8 = 32
$ Resultado esperado: 32
fonc [int] suma_fila([int] n) {
    [int] total = 0;
    pour ([int] i = 0; i < n; i = i + 1) {
        [int] fila = 0;
        pour ([int] j = 0; j < 3; j = j + 1) {
            fila = fila + j * (j + 1);
        }
        total = total + fila;
    }
    ret total;
}

fonc [int] main() {
    ret suma_fila(4);
}
