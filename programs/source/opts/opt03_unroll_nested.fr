$ opt03_unroll_nested.fr
$ Loop unrolling -- bucles anidados, outer N=6 variable, inner trip-count=4 constante.
$ mat_sum(6): para cada fila i acumula row_acc = sum_{j=1}^{4}(i+1)*(j+1),
$ mas un bias acumulativo. Inner loop es el candidato principal a unrolling.
$ Resultado esperado: 245

fonc [int] mat_sum([int] n) {
    [int] total = 0;
    [int] bias  = 0;
    pour ([int] i = 0; i < n; i = i + 1) {
        [int] row_acc = 0;
        pour ([int] j = 0; j < 4; j = j + 1) {
            [int] ri   = i + 1;
            [int] rj   = j + 1;
            [int] cell = ri * rj;
            row_acc = row_acc + cell;
        }
        bias  = bias + i;
        total = total + row_acc + bias;
    }
    ret total;
}

fonc [int] main() {
    ret mat_sum(6);
}
