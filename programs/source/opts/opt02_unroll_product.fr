$ opt02_unroll_product.fr
$ Loop unrolling -- N variable pequeno, multiples temporales por iteracion.
$ Serie cuadratica: total = sum(i*(i+1)*k) para i=0..n-1, con n=5, k=3.
$ Terminos: 0,6,18,36,60 -> total=120
$ Resultado esperado: 120

fonc [int] quad_sum([int] n, [int] k) {
    [int] total = 0;
    [int] prev  = 0;
    pour ([int] i = 0; i < n; i = i + 1) {
        [int] next   = i + 1;
        [int] pair   = i * next;
        [int] contrib = pair * k;
        [int] delta  = contrib - prev;
        total = total + contrib;
        prev  = contrib;
    }
    ret total;
}

fonc [int] main() {
    ret quad_sum(5, 3);
}
