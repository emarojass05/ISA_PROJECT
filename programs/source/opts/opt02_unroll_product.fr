$ opt02_unroll_product.fr
$ Loop unrolling: secuencia tipo fibonacci con trip-count 4.
$ Dos variables actualizadas por iteracion — genera WAR interno.
$ a=0, b=1 → 4 iters → a=3, b=5. Resultado esperado: 5
fonc [int] fib_iter() {
    [int] a = 0;
    [int] b = 1;
    pour ([int] i = 0; i < 4; i = i + 1) {
        [int] t = a + b;
        a = b;
        b = t;
    }
    ret b;
}

fonc [int] main() {
    ret fib_iter();
}
