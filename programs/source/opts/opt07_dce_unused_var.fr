$ opt07_dce_unused_var.fr
$ DCE -- solo la cadena vmin/vmax sobrevive; suma, promedio, ajuste y factor
$ son todos muertos. DCE debe eliminar ~7 instrucciones.
$ v1=3,v2=7,v3=2,v4=9,v5=5: rango = vmax - vmin = 9 - 2 = 7
$ Resultado esperado: 7

fonc [int] solo_rango() {
    [int] v1 = 3;
    [int] v2 = 7;
    [int] v3 = 2;
    [int] v4 = 9;
    [int] v5 = 5;
    [int] suma   = v1 + v2 + v3 + v4 + v5;
    [int] prom   = suma / 5;
    [int] vmin   = v3;
    [int] vmax   = v4;
    [int] ajuste = prom * 2;
    [int] factor = ajuste - vmin;
    [int] rango  = vmax - vmin;
    ret rango;
}

fonc [int] main() {
    ret solo_rango();
}
