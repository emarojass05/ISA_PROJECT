$ opt01_unroll_poly.fr
$ Loop unrolling -- N constante (8), multiples operaciones por iteracion.
$ Evalua polinomio con coeficientes Fibonacci en x=2.
$ Coefs = 1,1,2,3,5,8,13,21; adj_i = fa*power + fa - 1
$ Resultado esperado: 3937

fonc [int] poly_fib([int] x) {
    [int] fa    = 1;
    [int] fb    = 1;
    [int] power = 1;
    [int] acc   = 0;
    pour ([int] i = 0; i < 8; i = i + 1) {
        [int] term = fa * power;
        [int] adj  = term + fa - 1;
        acc   = acc + adj;
        power = power * x;
        [int] fc = fa + fb;
        fa = fb;
        fb = fc;
    }
    ret acc;
}

fonc [int] main() {
    ret poly_fib(2);
}
