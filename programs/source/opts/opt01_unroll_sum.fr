$ opt01_unroll_sum.fr
$ Loop unrolling: suma de cubos con trip-count 4.
$ Cada iteracion calcula i*i*i usando un temporal intermedio.
$ Resultado esperado: 1^3 + 2^3 + 3^3 + 4^3 = 1+8+27+64 = 100
fonc [int] suma_cubos() {
    [int] acc = 0;
    pour ([int] i = 1; i <= 4; i = i + 1) {
        [int] cuadrado = i * i;
        acc = acc + cuadrado * i;
    }
    ret acc;
}

fonc [int] main() {
    ret suma_cubos();
}
