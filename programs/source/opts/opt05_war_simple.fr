$ opt05_war_simple.fr
$ Renaming -- secuencia WAR: p, q, r, s se calculan de a/b originales,
$ luego a y b se redefinen; renaming rompe la dependencia falsa.
$ a=6, b=4: p=24, q=10, r=2, s=36 -> a=34, b=72 -> extra=106
$ Resultado esperado: 106

fonc [int] war_sequence([int] ai, [int] bi) {
    [int] a = ai;
    [int] b = bi;
    [int] p = a * b;
    [int] q = a + b;
    [int] r = a - b;
    [int] s = a * a;
    a = p + q;
    b = r * s;
    [int] extra = a + b;
    ret extra;
}

fonc [int] main() {
    ret war_sequence(6, 4);
}
