$ opt08_dce_chain.fr
$ DCE -- cadena profunda de 7 variables muertas. Solo result = n+m es vivo.
$ DCE debe propagar la muerte desde d7 hasta d1 y eliminar toda la cadena.
$ n=8, m=5: result = 13
$ Resultado esperado: 13

fonc [int] only_sum([int] n, [int] m) {
    [int] result = n + m;
    [int] d1 = n * m;
    [int] d2 = d1 - m;
    [int] d3 = d2 * n;
    [int] d4 = d3 / m;
    [int] d5 = d4 + result;
    [int] d6 = d5 * d1;
    [int] d7 = d6 - n;
    ret result;
}

fonc [int] main() {
    ret only_sum(8, 5);
}
