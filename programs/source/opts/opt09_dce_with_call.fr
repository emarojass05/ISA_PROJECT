$ opt09_dce_with_call.fr
$ DCE -- llamadas a funcion con posibles side-effects se conservan;
$ variables muertas sum_ab y product se eliminan, pero sq_a y sq_b
$ deben mantenerse porque square() podria tener efectos.
$ a=5, b=3, c=7: live = a*c - b = 35 - 3 = 32
$ Resultado esperado: 32

fonc [int] square([int] x) {
    [int] s = x * x;
    ret s;
}

fonc [int] compute([int] a, [int] b, [int] c) {
    [int] sq_a   = square(a);
    [int] sq_b   = square(b);
    [int] sum_ab = sq_a + sq_b;
    [int] product = sum_ab * c;
    [int] live   = a * c - b;
    ret live;
}

fonc [int] main() {
    ret compute(5, 3, 7);
}
