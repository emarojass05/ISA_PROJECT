$ opt12_func_chain.fr
$ Cadena de 3 funciones con logica no trivial.
$ cuadrado(x) = x*x
$ suma_cuadrados(a,b) = a^2 + b^2
$ resultado(a,b) = suma_cuadrados(a,b) + a + b
$ resultado(3,4) = (9+16) + 3 + 4 = 32
$ Resultado esperado: 32
fonc [int] cuadrado([int] x) {
    ret x * x;
}

fonc [int] suma_cuadrados([int] a, [int] b) {
    [int] ca = cuadrado(a);
    [int] cb = cuadrado(b);
    ret ca + cb;
}

fonc [int] resultado([int] a, [int] b) {
    [int] sc = suma_cuadrados(a, b);
    ret sc + a + b;
}

fonc [int] main() {
    ret resultado(3, 4);
}
