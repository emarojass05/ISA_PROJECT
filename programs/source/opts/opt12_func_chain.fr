$ opt12_func_chain.fr
$ Scheduling -- cadena multi-funcion; dentro de cada funcion hay instrucciones
$ paralelas elegibles para reordenamiento por el scheduler.
$ nivel1(5): a=15,b=12,c=25 -> 52
$ nivel2(52): p=13,q=2,r=26,s=26 -> 26
$ nivel3(26): m=53,n=23,k=1219,j=76 -> 1143
$ Resultado esperado: 1143

fonc [int] nivel1([int] x) {
    [int] a = x * 3;
    [int] b = x + 7;
    [int] c = x * x;
    ret a + b + c;
}

fonc [int] nivel2([int] v) {
    [int] p = v / 4;
    [int] q = v % 5;
    [int] r = p * q;
    [int] s = v - r;
    ret s;
}

fonc [int] nivel3([int] u) {
    [int] m = u * 2 + 1;
    [int] n = u - 3;
    [int] k = m * n;
    [int] j = m + n;
    ret k - j;
}

fonc [int] main() {
    [int] r1 = nivel1(5);
    [int] r2 = nivel2(r1);
    [int] r3 = nivel3(r2);
    ret r3;
}
