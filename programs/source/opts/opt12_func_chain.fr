$ opt12_func_chain.fr
$ Cadena de llamadas a funciones: f3 llama a f2, f2 llama a f1.
$ Verifica que el pipeline no rompe el orden de calls ni los params.
$ Resultado esperado: f1(2)=4, f2(2)=5, f3(2)=10
fonc [int] f1([int] x) {
    ret x + x;
}

fonc [int] f2([int] x) {
    [int] base = f1(x);
    ret base + 1;
}

fonc [int] f3([int] x) {
    [int] parcial = f2(x);
    ret parcial * 2;
}

fonc [int] main() {
    ret f3(2);
}
