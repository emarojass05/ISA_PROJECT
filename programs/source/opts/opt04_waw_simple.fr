$ opt04_waw_simple.fr
$ Renaming -- cadenas WAW paralelas en x e y.
$ Muchas redefiniciones de x y y; renaming las separa en nombres distintos
$ para exponer paralelismo al scheduler.
$ x: 4->10->30->22->484->121   y: 7->14->17->289
$ Resultado esperado: 410 (121 + 289)

fonc [int] waw_parallel([int] xi, [int] yi) {
    [int] x = xi;
    [int] y = yi;
    x = x + 6;
    y = y * 2;
    x = x * 3;
    y = y + 3;
    x = x - 8;
    x = x * x;
    y = y * y;
    x = x / 4;
    ret x + y;
}

fonc [int] main() {
    ret waw_parallel(4, 7);
}
