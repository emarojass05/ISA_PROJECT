$ opt04_waw_simple.fr
$ WAW multiple: x se reescribe 3 veces, el renamer debe crear
$ versiones independientes _rn0_x, _rn1_x permitiendo scheduling.
$ x=2 -> x=x*3=6 -> x=x+4=10, y=x+1=11 (usa x=6 intermedio)
$ Resultado esperado: x + y = 10 + 11 = 21
fonc [int] waw_demo() {
    [int] x = 2;
    x = x * 3;
    [int] y = x + 1;
    x = x + 4;
    ret x + y;
}

fonc [int] main() {
    ret waw_demo();
}
