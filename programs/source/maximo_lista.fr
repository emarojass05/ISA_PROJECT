fonc [int] maximo_lista([int] *lista, [int] tam) {
    $ Si la lista esta vacia, retorna -1 como codigo de error
    si (tam == 0) {
        ret 0 - 1;
    }

    [int] maximo = lista@(0);
    pour ([int] i = 1; i < tam; i = i + 1) {
        si (lista@(i) > maximo) {
            maximo = lista@(i);
        }
    }
    ret maximo;
}

fonc [int] main() {
    [int] *datos = {3, 4, 5, 24, 5, 65, 46};
    [int] resultado = maximo_lista(datos, 7);
    ret resultado;
}