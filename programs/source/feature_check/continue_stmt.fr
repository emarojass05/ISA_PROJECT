$ Feature: suivre (continue) statement inside loops
$ Expected return (x3): 6
$ Sum even numbers 1..5: skip odd with suivre, sum 2+4 = 6

fonc [int] main() {
    [int] sum = 0;
    pour ([int] i = 1; i <= 5; i++) {
        si (i % 2 != 0) {
            suivre;
        }
        sum = sum + i;
    }
    ret sum;
}
