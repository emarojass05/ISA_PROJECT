$ Feature: function with >7 parameters (tests stack-based arg passing beyond a0..a6)
$ Expected return (x3): 36
$ Sum of 1+2+3+4+5+6+7+8 = 36

fonc [int] sum8([int] a, [int] b, [int] c, [int] d, [int] e, [int] f, [int] g, [int] h) {
    ret a + b + c + d + e + f + g + h;
}

fonc [int] main() {
    ret sum8(1, 2, 3, 4, 5, 6, 7, 8);
}
