$ Feature: relational and equality operators > < >= <= == !=
$ Expected return (x3): 6
$ Each true comparison contributes 1, false 0; sum of 6 true conditions

fonc [int] main() {
    [int] r1 = 5 > 3;
    [int] r2 = 2 < 10;
    [int] r3 = 4 >= 4;
    [int] r4 = 3 <= 3;
    [int] r5 = 7 == 7;
    [int] r6 = 8 != 9;
    ret r1 + r2 + r3 + r4 + r5 + r6;
}
