$ Feature: pour (for) loop with i++, i--, and assignment update
$ Expected return (x3): 20
$ Loop 1: sum += i for i=1..4 => 10
$ Loop 2: sum += 1 for i=4..1 (i--) => 10, total: 20 (but added to prior sum=10 => 20)

fonc [int] main() {
    [int] sum = 0;
    pour ([int] i = 1; i <= 4; i++) {
        sum = sum + i;
    }
    pour ([int] j = 4; j >= 1; j--) {
        sum = sum + 1;
    }
    ret sum;
}
