`define OPCODE_R 3'b000
`define OPCODE_I 3'b001
`define OPCODE_S 3'b010
`define OPCODE_B 3'b011
`define OPCODE_J 3'b100

`define ALU_ADD 4'b0000
`define ALU_SUB 4'b0001
`define ALU_MUL 4'b0010
`define ALU_DIV 4'b0011
`define ALU_REM 4'b0100
`define ALU_AND 4'b0101
`define ALU_OR  4'b0110
`define ALU_XOR 4'b0111
`define ALU_SLL 4'b1000
`define ALU_SRL 4'b1001

